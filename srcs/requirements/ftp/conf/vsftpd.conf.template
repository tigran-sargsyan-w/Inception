listen=YES
listen_ipv6=NO
background=NO

anonymous_enable=NO
local_enable=YES
write_enable=YES
local_umask=022

chroot_local_user=YES
allow_writeable_chroot=YES
local_root=/var/www/html

pasv_enable=YES
pasv_address=__FTP_PASV_ADDRESS__
pasv_min_port=__FTP_PASV_MIN_PORT__
pasv_max_port=__FTP_PASV_MAX_PORT__

secure_chroot_dir=/var/run/vsftpd/empty
pam_service_name=vsftpd

userlist_enable=YES
userlist_deny=NO
userlist_file=/etc/vsftpd.userlist

xferlog_enable=YES
force_dot_files=YES